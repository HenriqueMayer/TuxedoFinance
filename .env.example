# Copy to `.env` and fill in real values before running `docker compose up`.
# Never commit the real `.env` — it is already gitignored.

# Long, random, and unique. Required in production: the app refuses to start
# with DEBUG=False while this is unset, blank, still the placeholder below,
# still the development fallback committed in core/settings.py, or shorter
# than the 50 characters the generator produces. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# IMPORTANT — double every `$` in the value you paste (write `$$`, not `$`).
# Docker Compose expands variable references inside the values it reads from
# this file, so a key containing `$abc` quietly loses those characters before
# Django ever sees it: Compose only prints `The "abc" variable is not set.
# Defaulting to a blank string.` and carries on. The app then runs with a
# different, shorter key than the one written here, and every session cookie
# signed with the real one stops validating. The length check in
# core/settings.py exists to catch exactly this.
SECRET_KEY=change-me-to-a-long-random-secret-key

# Must be False for any real deployment.
DEBUG=False

# Set to True only once this instance is actually served over TLS. It enables
# secure-only session/CSRF cookies, the HTTP-to-HTTPS redirect, HSTS, and
# trust in the proxy's X-Forwarded-Proto header. Leave it False for the
# default `docker compose up`, which publishes plain HTTP on :8000 — browsers
# never send a Secure cookie over HTTP, so login would not work.
HTTPS=False

# Comma-separated hostnames/IPs this instance is served from.
ALLOWED_HOSTS=localhost,127.0.0.1

# Where the SQLite file lives inside the container. Matches the db-data
# volume mount in docker-compose.yml.
SQLITE_PATH=/app/data/db.sqlite3

# Currency shown throughout the UI — sets both the symbol and the number
# format. Supported: BRL, USD, EUR, GBP, JPY, CHF (see core/currencies.py).
CURRENCY=BRL

# Verbosity of the application log on stdout (`docker compose logs`). Use
# DEBUG to trace a problem, WARNING to quieten a healthy instance.
# Unhandled 500s are logged with their traceback at every level.
LOG_LEVEL=INFO
