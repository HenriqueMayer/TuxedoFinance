# Generate a private value for your local .env; do not use this placeholder.
SECRET_KEY=replace-with-a-generated-secret-key

# Optional local settings
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOW_SIGNUPS=True
LOG_LEVEL=INFO

# Optional private runtime-data location
# TUXEDO_DATA_DIR=/absolute/path/to/tuxedo-finance-data

# Optional ChatGPT connection: authorization and inference are independent opt-ins.
# Keep both off unless intentionally connecting this installation; no paid API fallback.
ASSISTANT_OPENAI_AUTH_ENABLED=False
ASSISTANT_OPENAI_INFERENCE_ENABLED=False
# The callback port must match the local Django server. Use 127.0.0.1, not localhost.
ASSISTANT_OPENAI_CALLBACK_URL=http://127.0.0.1:8000/assistant/connections/callback/
# ASSISTANT_PRIVATE_DIR=/absolute/private/path/to/assistant-credentials
