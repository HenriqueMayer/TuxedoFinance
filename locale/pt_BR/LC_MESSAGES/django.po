#, python-format
msgid "Welcome back, %(username)s."
msgstr "Bem-vindo de volta, %(username)s."

#, python-format
msgid "Welcome to Tuxedo Finance, %(username)s. Your account is ready."
msgstr "Bem-vindo ao Tuxedo Finance, %(username)s. Sua conta está pronta."

msgid "Your settings were updated."
msgstr "Suas configurações foram atualizadas."

msgid "Name"
msgstr "Nome"

msgid "You already have a bank with this name."
msgstr "Você já tem um banco com este nome."

msgid "Balance immediately before the first ledger movement."
msgstr "Saldo imediatamente anterior à primeira movimentação."

msgid "Bank"
msgstr "Banco"

msgid "Currency"
msgstr "Moeda"

msgid "Opening balance"
msgstr "Saldo inicial"

msgid "Pix enabled"
msgstr "PIX habilitado"

msgid "This bank already has an account with this name and currency."
msgstr "Este banco já tem uma conta com este nome e moeda."

msgid "Currency cannot change after financial activity."
msgstr "A moeda não pode ser alterada após uma atividade financeira."

msgid "The bank cannot change after financial activity."
msgstr "O banco não pode ser alterado após uma atividade financeira."

msgid "This account already has a card with this name."
msgstr "Esta conta já tem um cartão com este nome."

msgid "The account cannot change after card activity."
msgstr "A conta não pode ser alterada após uma movimentação do cartão."

msgid "Account"
msgstr "Conta"

msgid "Purchases on or after this day enter the next statement."
msgstr "Compras feitas neste dia ou depois entram na próxima fatura."

msgid "Clamped to the last day in shorter months."
msgstr "Ajustado para o último dia nos meses mais curtos."

msgid "Card type"
msgstr "Tipo do cartão"

msgid "Closing day"
msgstr "Dia de fechamento"

msgid "Due day"
msgstr "Dia de vencimento"

msgid "Optional. Independent programs may have no bank."
msgstr "Opcional. Programas independentes podem não ter banco."

msgid "Optional. Select one or more eligible credit cards."
msgstr "Opcional. Selecione um ou mais cartões de crédito elegíveis."

msgid "Cards"
msgstr "Cartões"

msgid "Unit name"
msgstr "Nome da unidade"

msgid "You already have a loyalty program with this name."
msgstr "Você já tem um programa de fidelidade com este nome."

msgid "Every card must belong to you."
msgstr "Todos os cartões devem pertencer a você."

msgid "Every selected card must belong to the selected bank."
msgstr "Todos os cartões selecionados devem pertencer ao banco selecionado."

msgid "The program must belong to the selected bank."
msgstr "O programa deve pertencer ao banco selecionado."

msgid "For another currency, enter the amount actually received."
msgstr "Para outra moeda, informe o valor efetivamente recebido."

msgid "Source account"
msgstr "Conta de origem"

msgid "Destination account"
msgstr "Conta de destino"

msgid "Source amount"
msgstr "Valor de origem"

msgid "Destination amount"
msgstr "Valor de destino"

msgid "Date"
msgstr "Data"

msgid "Notes"
msgstr "Observações"

msgid "Program"
msgstr "Programa"

msgid "Direction"
msgstr "Direção"

msgid "Kind"
msgstr "Natureza"

msgid "Points or miles"
msgstr "Pontos ou milhas"

msgid "Invoice"
msgstr "Fatura"

msgid "Funding account"
msgstr "Conta de pagamento"

msgid "Funding credit card"
msgstr "Cartão de crédito usado no pagamento"

msgid "Amount paid"
msgstr "Valor pago"

msgid "Required only for points awarded from a selected credit-card invoice."
msgstr ""
"Obrigatório somente para pontos concedidos por uma fatura de cartão de "
"crédito selecionada."

msgid "For purchased points, choose this or a credit card."
msgstr "Para pontos comprados, escolha esta opção ou um cartão de crédito."

msgid "Required only when purchasing points."
msgstr "Obrigatório somente ao comprar pontos."

msgid "Money credited in the target account currency."
msgstr "Valor creditado na moeda da conta de destino."

msgid "If positive, choose exactly one account or credit card below."
msgstr ""
"Se for positivo, escolha exatamente uma conta ou um cartão de crédito abaixo."

msgid "Points"
msgstr "Pontos"

msgid "Target account"
msgstr "Conta de destino"

msgid "Target amount"
msgstr "Valor de destino"

msgid "Iof amount"
msgstr "Valor do IOF"

msgid "Iof account"
msgstr "Conta do IOF"

msgid "Iof credit card"
msgstr "Cartão de crédito do IOF"

msgid "How many target-currency units equal one source unit."
msgstr ""
"Quantas unidades da moeda de destino equivalem a uma unidade da moeda de "
"origem."

msgid "From currency"
msgstr "Moeda de origem"

msgid "To currency"
msgstr "Moeda de destino"

msgid "Rate"
msgstr "Taxa"

msgid "Effective date"
msgstr "Data de vigência"

msgid "The bank must belong to the account owner."
msgstr "O banco deve pertencer ao titular da conta."

msgid "The account must belong to the card owner."
msgstr "A conta deve pertencer ao titular do cartão."

msgid "Physical"
msgstr "Físico"

msgid "Virtual"
msgstr "Virtual"

msgid "Additional"
msgstr "Adicional"

msgid "Scheduled"
msgstr "Agendada"

msgid "Paid"
msgstr "Paga"

msgid "The card must belong to the invoice owner."
msgstr "O cartão deve pertencer ao titular da fatura."

msgid "Reference month must be the first day of a month."
msgstr "O mês de referência deve ser o primeiro dia de um mês."

msgid "Unknown"
msgstr "Desconhecida"

msgid "Reconstructed"
msgstr "Reconstruída"

msgid "Captured"
msgstr "Capturada"

#, python-format
msgid "%(source)s to %(destination)s"
msgstr "%(source)s para %(destination)s"

msgid "Source and destination must differ."
msgstr "A origem e o destino devem ser diferentes."

msgid "Both accounts must have the same owner."
msgstr "As duas contas devem ter o mesmo titular."

msgid "The account must belong to the transfer owner."
msgstr "A conta deve pertencer ao titular da transferência."

msgid "Credit"
msgstr "Crédito"

msgid "Debit"
msgstr "Débito"

msgid "Income"
msgstr "Receita"

msgid "Expense"
msgstr "Despesa"

msgid "Transfer"
msgstr "Transferência"

msgid "Investment"
msgstr "Investimento"

msgid "Reward"
msgstr "Recompensa"

msgid "Adjustment"
msgstr "Ajuste"

msgid "The account must belong to the movement owner."
msgstr "A conta deve pertencer ao titular da movimentação."

msgid "The invoice must belong to the movement owner."
msgstr "A fatura deve pertencer ao titular da movimentação."

msgid "The invoice must settle from its linked account."
msgstr "A fatura deve ser liquidada pela conta vinculada a ela."

msgid "Invoice settlements must be INVOICE debit movements."
msgstr ""
"Liquidações de fatura devem ser movimentações de débito do tipo INVOICE."

msgid "The transfer must belong to the movement owner."
msgstr "A transferência deve pertencer ao titular da movimentação."

msgid "A transfer-linked movement must have TRANSFER kind."
msgstr ""
"Uma movimentação vinculada a uma transferência deve ter o tipo TRANSFER."

msgid "The bank must belong to the program owner."
msgstr "O banco deve pertencer ao titular do programa."

msgid "Every card must belong to the program owner."
msgstr "Todos os cartões devem pertencer ao titular do programa."

msgid "Invoice award"
msgstr "Pontos da fatura"

msgid "Purchase"
msgstr "Compra"

msgid "Expiration"
msgstr "Expiração"

msgid "Redemption"
msgstr "Resgate"

msgid "The program must belong to the entry owner."
msgstr "O programa deve pertencer ao titular do lançamento."

msgid "The invoice must belong to the entry owner."
msgstr "A fatura deve pertencer ao titular do lançamento."

msgid "Only invoice awards may reference an invoice."
msgstr ""
"Somente a concessão de pontos de fatura pode fazer referência a uma fatura."

msgid "The invoice card is not linked to this program."
msgstr "O cartão da fatura não está vinculado a este programa."

msgid "Purchased points must be a credit."
msgstr "Pontos comprados devem ser um crédito."

msgid "A purchase requires exactly one funding instrument."
msgstr "Uma compra exige exatamente um meio de pagamento."

msgid "A purchase requires a positive cash amount."
msgstr "Uma compra exige um valor monetário positivo."

msgid "Funding fields are only used when purchasing points."
msgstr "Os campos de pagamento são usados somente na compra de pontos."

msgid "Invoice points must be a credit."
msgstr "Pontos de fatura devem ser um crédito."

msgid "Expiration and redemption entries must be debits."
msgstr "Lançamentos de expiração e resgate devem ser débitos."

msgid "The funding instrument must belong to the entry owner."
msgstr "O meio de pagamento deve pertencer ao titular do lançamento."

#, python-format
msgid "%(program)s: %(points)s points"
msgstr "%(program)s: %(points)s pontos"

msgid "This funding instrument must belong to the redemption owner."
msgstr "Este meio de pagamento deve pertencer ao titular do resgate."

msgid "Positive IOF requires exactly one funding instrument."
msgstr "Um IOF positivo exige exatamente um meio de pagamento."

msgid "Do not select an IOF instrument when IOF is zero."
msgstr "Não selecione um meio de pagamento do IOF quando o IOF for zero."

msgid "Currencies must differ."
msgstr "As moedas devem ser diferentes."

#, python-format
msgid "Points purchase: %(program)s"
msgstr "Compra de pontos: %(program)s"

msgid "One or more transfer accounts no longer exist."
msgstr "Uma ou mais contas da transferência não existem mais."

#, python-format
msgid ""
"No %(from_currency)s/%(to_currency)s exchange rate is available as of "
"%(date)s."
msgstr ""
"Não há taxa de câmbio %(from_currency)s/%(to_currency)s disponível até "
"%(date)s."

msgid "The program does not have enough points."
msgstr "O programa não tem pontos suficientes."

#, python-format
msgid "IOF on reward redemption: %(notes)s"
msgstr "IOF sobre resgate de recompensa: %(notes)s"

msgid "A record with these values already exists."
msgstr "Já existe um registro com estes valores."

msgid "New bank"
msgstr "Novo banco"

msgid "Edit bank"
msgstr "Editar banco"

msgid "New account"
msgstr "Nova conta"

msgid "Edit account"
msgstr "Editar conta"

msgid "New debit card"
msgstr "Novo cartão de débito"

msgid "Edit debit card"
msgstr "Editar cartão de débito"

msgid "New credit card"
msgstr "Novo cartão de crédito"

msgid "Edit credit card"
msgstr "Editar cartão de crédito"

msgid "New loyalty program"
msgstr "Novo programa de fidelidade"

msgid "Edit loyalty program"
msgstr "Editar programa de fidelidade"

msgid ""
"This item cannot be deleted because financial records still reference it."
msgstr ""
"Este item não pode ser excluído porque ainda é referenciado por registros "
"financeiros."

msgid "Item deleted."
msgstr "Item excluído."

msgid "Transfer between my accounts"
msgstr "Transferência entre minhas contas"

msgid "Transfer recorded without changing income or expenses."
msgstr "Transferência registrada sem alterar receitas ou despesas."

msgid "New points or miles entry"
msgstr "Novo lançamento de pontos ou milhas"

msgid "Points entry recorded."
msgstr "Lançamento de pontos registrado."

msgid "Edit points or miles entry"
msgstr "Editar lançamento de pontos ou milhas"

msgid "Points entry updated."
msgstr "Lançamento de pontos atualizado."

msgid "Convert points or miles to account balance"
msgstr "Converter pontos ou milhas em saldo da conta"

msgid "Reward converted and IOF funding recorded."
msgstr "Recompensa convertida e pagamento do IOF registrado."

msgid "New exchange rate"
msgstr "Nova taxa de câmbio"

msgid "Category type"
msgstr "Tipo de categoria"

msgid "Parent category"
msgstr "Categoria principal"

msgid "No parent category"
msgstr "Sem categoria principal"

msgid "Unclassified (income and expense)"
msgstr "Sem classificação (receita e despesa)"

msgid "You already have a category with this name."
msgstr "Você já tem uma categoria com este nome."

msgid "CSV file"
msgstr "Arquivo CSV"

msgid ""
"Use a CSV file with the columns name, transaction_type and parent_category."
msgstr ""
"Use um arquivo CSV com as colunas name, transaction_type e parent_category."

msgid "Select a CSV file."
msgstr "Selecione um arquivo CSV."

msgid "Optional. Unclassified categories can be used for income and expenses."
msgstr ""
"Opcional. Categorias sem classificação podem ser usadas para receitas e "
"despesas."

msgid ""
"This category has transactions of another type and cannot be classified that "
"way."
msgstr ""
"Esta categoria possui transações de outro tipo e não pode receber essa "
"classificação."

#, python-format
msgid "Category \"%(name)s\" created."
msgstr "Categoria \"%(name)s\" criada."

#, python-format
msgid "Category \"%(name)s\" updated."
msgstr "Categoria \"%(name)s\" atualizada."

#, python-format
msgid ""
"\"%(name)s\" cannot be deleted because it is still used by existing "
"transactions."
msgstr ""
"\"%(name)s\" não pode ser excluída porque ainda é usada por transações "
"existentes."

#, python-format
msgid "Category \"%(name)s\" deleted."
msgstr "Categoria \"%(name)s\" excluída."

msgid ""
"Categories cannot be deleted while they are used by existing transactions."
msgstr ""
"As categorias não podem ser excluídas enquanto estiverem sendo usadas por "
"transações existentes."

msgid "All categories deleted."
msgstr "Todas as categorias foram excluídas."

msgid "The CSV file must use UTF-8 encoding."
msgstr "O arquivo CSV deve usar a codificação UTF-8."

msgid "The CSV header must be: name,transaction_type,parent_category."
msgstr "O cabeçalho do CSV deve ser: name,transaction_type,parent_category."

#, python-format
msgid "Line %(line)s has no category name."
msgstr "A linha %(line)s não possui um nome de categoria."

#, python-format
msgid "Line %(line)s contains a name longer than 100 characters."
msgstr "A linha %(line)s contém um nome com mais de 100 caracteres."

#, python-format
msgid "Line %(line)s has an invalid transaction type."
msgstr "A linha %(line)s possui um tipo de transação inválido."

#, python-format
msgid "The category \"%(name)s\" appears more than once."
msgstr "A categoria \"%(name)s\" aparece mais de uma vez."

#, python-format
msgid "The category \"%(name)s\" cannot be its own parent."
msgstr "A categoria \"%(name)s\" não pode ser sua própria categoria principal."

#, python-format
msgid "Parent category not found: %(name)s."
msgstr "Categoria principal não encontrada: %(name)s."

msgid "The CSV contains a circular category hierarchy."
msgstr "O CSV contém uma hierarquia circular de categorias."

#, python-format
msgid ""
"%(created)s categories imported; %(skipped)s existing categories skipped."
msgstr ""
"%(created)s categorias importadas; %(skipped)s categorias existentes "
"ignoradas."

msgid "English"
msgstr "Inglês"

msgid "Brazilian Portuguese"
msgstr "Português brasileiro"

msgid "Installments"
msgstr "Parcelas"

msgid "Fixed"
msgstr "Fixa"

msgid "One-off"
msgstr "Avulsa"

msgid "All time"
msgstr "Todo o período"

msgid "Expenses"
msgstr "Despesas"

msgid "Investments"
msgstr "Investimentos"

msgid "Product destination"
msgstr "Produto de destino"

msgid "Asset"
msgstr "Ativo"

msgid "Type"
msgstr "Tipo"

msgid "Investment amount"
msgstr "Valor do investimento"

msgid "Quantity (unit-based assets)"
msgstr "Quantidade (ativos por unidade)"

msgid "Unit price (unit-based assets)"
msgstr "Preço unitário (ativos por unidade)"

msgid "Fees"
msgstr "Taxas"

msgid "Cash amount (unit-based assets)"
msgstr "Valor em dinheiro (ativos por unidade)"

msgid "Source program"
msgstr "Programa de origem"

msgid "Source points"
msgstr "Pontos de origem"

msgid "Reason"
msgstr "Motivo"

msgid ""
"Required for monetary assets such as savings pots; it is also used for the "
"bank movement."
msgstr ""
"Obrigatório para ativos monetários, como cofrinhos; também é usado para a "
"movimentação bancária."

msgid "Required only for assets valued by units and price."
msgstr "Obrigatório somente para ativos avaliados por unidades e preço."

msgid "Operation fees; this does not change gross value."
msgstr "Taxas da operação; isto não altera o valor bruto."

msgid "Actual debit/credit in the selected account native currency."
msgstr "Débito/crédito efetivo na moeda nativa da conta selecionada."

msgid "For an account-funded deposit only."
msgstr "Somente para aporte financiado por uma conta."

msgid "For a points-funded deposit only."
msgstr "Somente para aporte financiado por pontos."

msgid "For a withdrawal only."
msgstr "Somente para resgate."

msgid "This bank already has a product with this name."
msgstr "Este banco já tem um produto com este nome."

msgid "Code"
msgstr "Código"

msgid "Asset class"
msgstr "Classe do ativo"

msgid "How this asset is valued"
msgstr "Como este ativo é valorizado"

msgid "Opening quantity"
msgstr "Quantidade inicial"

msgid "Opening unit price"
msgstr "Preço unitário inicial"

msgid "Opening balance product"
msgstr "Produto do saldo inicial"

msgid "Short identifier, for example BTC, USD, PETR4, or CDB-2028."
msgstr "Identificador curto, por exemplo BTC, USD, PETR4 ou CDB-2028."

msgid "What the asset is: for example BTC is Crypto and PETR4 is Equity."
msgstr "O que é o ativo: por exemplo, BTC é Cripto e PETR4 é Ação."

msgid "Currency used to price it: for example PETR4 is priced in BRL."
msgstr ""
"Moeda usada para precificá-lo: por exemplo, PETR4 é precificada em BRL."

msgid ""
"Monetary value is for savings pots and cash-like investments; units and "
"price is for traded assets."
msgstr ""
"O valor monetário é para cofrinhos e investimentos semelhantes a dinheiro; "
"unidades e preço são para ativos negociados."

msgid ""
"Existing balance before you start recording operations. Monetary assets only."
msgstr ""
"Saldo existente antes de começar a registrar operações. Somente para ativos "
"monetários."

msgid ""
"Existing units before you start recording operations. Unit-based assets only."
msgstr ""
"Unidades existentes antes de começar a registrar operações. Somente para "
"ativos baseados em unidades."

msgid "Price per existing unit. Unit-based assets only."
msgstr "Preço por unidade existente. Somente para ativos baseados em unidades."

msgid "Required when an opening balance or opening position is provided."
msgstr "Obrigatório quando um saldo ou uma posição inicial for informada."

msgid "You already have an asset with this code."
msgstr "Você já tem um ativo com este código."

msgid "Currency cannot be changed after this asset has investment operations."
msgstr ""
"A moeda não pode ser alterada depois que este ativo tiver operações de "
"investimento."

msgid ""
"Asset class cannot be changed after this asset has investment operations."
msgstr ""
"A classe do ativo não pode ser alterada depois que este ativo tiver "
"operações de investimento."

msgid ""
"Valuation mode cannot be changed after this asset has investment operations."
msgstr ""
"O modo de avaliação não pode ser alterado depois que este ativo tiver "
"operações de investimento."

msgid ""
"Opening balance cannot be changed after this asset has investment operations."
msgstr ""
"O saldo inicial não pode ser alterado depois que este ativo tiver operações "
"de investimento."

msgid ""
"Opening balance product cannot be changed after this asset has investment "
"operations."
msgstr ""
"O produto do saldo inicial não pode ser alterado depois que este ativo tiver "
"operações de investimento."

#, python-format
msgid "%(label)s cannot be changed after this asset has investment operations."
msgstr ""
"O campo %(label)s não pode ser alterado depois que este ativo tiver "
"operações de investimento."

msgid "Manual"
msgstr "Manual"

msgid "Monthly rate (Coming soon)"
msgstr "Taxa mensal (Em breve)"

msgid "Annual rate (Coming soon)"
msgstr "Taxa anual (Em breve)"

msgid "The bank must belong to the product owner."
msgstr "O banco deve pertencer ao titular do produto."

msgid "Monetary value"
msgstr "Valor monetário"

msgid "Units and price"
msgstr "Unidades e preço"

msgid "Liquidity"
msgstr "Liquidez"

msgid "Crypto"
msgstr "Cripto"

msgid "Fixed income"
msgstr "Renda fixa"

msgid "Equity"
msgstr "Ação"

msgid "Other"
msgstr "Outro"

msgid "Existing balance before the first recorded operation."
msgstr "Saldo existente antes da primeira operação registrada."

msgid "Existing units before the first recorded operation."
msgstr "Unidades existentes antes da primeira operação registrada."

msgid "Unit price of the existing units."
msgstr "Preço unitário das unidades existentes."

msgid "Product that holds the opening balance."
msgstr "Produto que mantém o saldo inicial."

msgid "Only monetary assets can have an opening balance."
msgstr "Somente ativos monetários podem ter saldo inicial."

msgid "Opening quantity and unit price must be provided together."
msgstr "A quantidade e o preço unitário iniciais devem ser informados juntos."

msgid "Select the product that holds the opening units."
msgstr "Selecione o produto que mantém as unidades iniciais."

msgid "Select an opening product only when there is an opening position."
msgstr ""
"Selecione um produto inicial somente quando houver uma posição inicial."

msgid "Select the product that holds the opening balance."
msgstr "Selecione o produto que mantém o saldo inicial."

msgid "Select an opening product only when there is an opening balance."
msgstr "Selecione um produto inicial somente quando houver saldo inicial."

msgid "Only unit-based assets can have opening units."
msgstr "Somente ativos baseados em unidades podem ter unidades iniciais."

msgid "Only unit-based assets can have an opening unit price."
msgstr "Somente ativos baseados em unidades podem ter preço unitário inicial."

msgid "The opening product must belong to the asset owner."
msgstr "O produto inicial deve pertencer ao titular do ativo."

msgid "Deposit"
msgstr "Aporte"

msgid "Withdrawal"
msgstr "Resgate"

msgid "Yield"
msgstr "Rendimento"

msgid "Position value for monetary assets."
msgstr "Valor da posição para ativos monetários."

msgid "Native amount debited from or credited to the selected account."
msgstr "Valor nativo debitado ou creditado na conta selecionada."

msgid "This selection must belong to the operation owner."
msgstr "Esta seleção deve pertencer ao titular da operação."

msgid "The product bank must belong to the operation owner."
msgstr "O banco do produto deve pertencer ao titular da operação."

msgid "Monetary assets require a positive investment amount."
msgstr "Ativos monetários exigem um valor de investimento positivo."

msgid "Monetary assets do not use quantity."
msgstr "Ativos monetários não usam quantidade."

msgid "Monetary assets do not use a unit price."
msgstr "Ativos monetários não usam preço unitário."

msgid "Unit-based assets require a positive quantity."
msgstr "Ativos baseados em unidades exigem uma quantidade positiva."

msgid "Unit-based assets require a positive unit price."
msgstr "Ativos baseados em unidades exigem um preço unitário positivo."

msgid "Unit-based assets derive value from quantity and unit price."
msgstr ""
"Ativos baseados em unidades derivam valor da quantidade e do preço unitário."

msgid "Deposit requires exactly one funding source."
msgstr "O aporte exige exatamente uma fonte de recursos."

msgid "Deposit does not use a destination account."
msgstr "O aporte não usa uma conta de destino."

msgid "Account-funded deposit requires a positive cash amount."
msgstr "O aporte financiado por conta exige um valor monetário positivo."

msgid "Account-funded deposit does not use points."
msgstr "O aporte financiado por conta não usa pontos."

msgid "Program-funded deposit requires positive points."
msgstr "O aporte financiado por programa exige pontos positivos."

msgid "Withdrawal requires a destination account."
msgstr "O resgate exige uma conta de destino."

msgid "Withdrawal requires a positive cash amount."
msgstr "O resgate exige um valor monetário positivo."

msgid "Withdrawal does not use a funding account."
msgstr "O resgate não usa uma conta de origem."

msgid "Withdrawal does not use a loyalty program."
msgstr "O resgate não usa um programa de fidelidade."

msgid "Withdrawal does not use points."
msgstr "O resgate não usa pontos."

msgid "Yield is internal and does not use cash or funding fields."
msgstr ""
"O rendimento é interno e não usa campos monetários nem de origem dos "
"recursos."

#, python-format
msgid "Investment %(id)s: %(product)s"
msgstr "Investimento %(id)s: %(product)s"

msgid "The investment operation must be saved before synchronization."
msgstr "A operação de investimento deve ser salva antes da sincronização."

msgid "Withdrawal exceeds the available position on this date."
