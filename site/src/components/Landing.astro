---
import { COMMANDS, COPY, LINKS, type Language } from "../copy";
import Page from "./Page.astro";

interface Props {
  language: Language;
}

const { language } = Astro.props;
const text = COPY[language];
const root = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const demo = `${root}app/index.html`;
---

<Page language={language} path={language === "en" ? "" : "pt-br/"}>
  <!-- The demonstration reads its language from the storage of this origin. -->
  <script is:inline slot="head" define:vars={{ language }}>
    try {
      localStorage.setItem("tuxedo.language", language);
    } catch {
      // Storage can be blocked. The demonstration then uses the language of the browser.
    }
  </script>

  <a class="skip" href="#demo">{text.skip}</a>

  <header class="wrap top">
    <a class="brand" href={language === "en" ? root : `${root}pt-br/`}>
      <svg viewBox="0 0 32 20" width="32" height="20" aria-hidden="true">
        <path d="M2 3.5 13 8v4L2 16.5zM30 3.5 19 8v4l11 4.5z" fill="var(--accent)"></path>
        <rect x="13" y="6.5" width="6" height="7" rx="1.5" fill="currentColor"></rect>
      </svg>
      Tuxedo Finance
    </a>
    <nav>
      <a href={LINKS.repository}>{text.source}</a>
      <a href={`${root}${text.other.path}`} hreflang={language === "en" ? "pt-BR" : "en"}>
        {text.other.label}
      </a>
    </nav>
  </header>

  <main>
    <div class="wrap hero">
      <h1>{text.heading}</h1>
      <p class="lead">{text.lead}</p>
      <p class="actions">
        <a class="button" href="#run">{text.install}</a>
        <a class="quiet" href={demo}>{text.fullScreen}</a>
      </p>
    </div>

    <div class="wrap" id="demo">
      <div class="window">
        <div class="window-bar">
          <span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="window-title">{text.windowTitle}</span>
          <a href={demo} aria-label={text.fullScreen}><span>{text.fullScreen}</span> ↗</a>
        </div>
        <iframe src={demo} title={text.frameTitle}></iframe>
      </div>
      <p class="caption">{text.caption}</p>
    </div>

    <div class="sheet">
      <section class="wrap">
        <h2>{text.placesTitle}</h2>
        <dl class="places">
          {
            text.places.map((place) => (
              <div>
                <dt>
                  <span class="name">{place.name}</span>
                  <span class="question">{place.question}</span>
                </dt>
                <dd>{place.text}</dd>
              </div>
            ))
          }
        </dl>
        <p class="links"><a href={LINKS.product}>{text.productDoc}</a></p>
      </section>

      <section class="wrap split">
        <h2>{text.limitsTitle}</h2>
        <ul class="limits">
          {text.limits.map((limit) => <li>{limit}</li>)}
        </ul>
      </section>

      <section class="wrap split">
        <h2>{text.yoursTitle}</h2>
        <p class="prose">{text.yours}</p>
      </section>

      <section class="wrap split" id="run">
        <h2>{text.runTitle}</h2>
        <div>
          <p class="prose">{text.runLead}</p>
          <pre><code>{COMMANDS}</code></pre>
          <p class="prose" style="margin-top: 1rem">{text.runAfter}</p>
          <p class="links">
            <a href={LINKS.docker}>{text.docker}</a>
            <a href={LINKS.repository}>{text.source}</a>
          </p>
        </div>
      </section>
    </div>
  </main>

  <footer>
    <div class="wrap">
      <p>
        {text.licenseText}{" "}
        <a href={LINKS.license}>{text.license}</a>
      </p>
      <p>© 2026 Henrique Mayer</p>
    </div>
  </footer>
</Page>
