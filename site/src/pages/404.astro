---
import Page from "../components/Page.astro";
import { COPY } from "../copy";

const text = COPY.en;
const root = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Page language="en" path="404.html">
  <main class="wrap lost">
    <h1>{text.notFound}</h1>
    <p><a href={root}>{text.home}</a></p>
  </main>
</Page>
