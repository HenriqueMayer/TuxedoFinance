# Keep the build context small and make sure local/dev-only artifacts
# never end up baked into the image.

.git
.gitignore
.github

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Runtime data — db.sqlite3 lives in the mounted volume, never in the image.
db.sqlite3
db.sqlite3-journal
staticfiles/
media/
*.log

# Generated Tailwind build output — compiled fresh inside the image.
static/css/output.css

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Environment variables — never bake secrets into the image.
.env
.env.*
!.env.example

# Docs / project management (not needed at runtime)
docs/
ProductRequirementsDocument.md
CLAUDE.md
.claude/
