{"openapi": "3.1.0", "info": {"title": "Tuxedo Finance", "version": "2.0.0.dev0", "description": ""}, "paths": {"/api/health": {"get": {"operationId": "config_api_health", "summary": "Report that the server answers", "parameters": [], "responses": {"200": {"description": "OK"}}, "tags": ["system"]}}, "/api/session": {"get": {"operationId": "accounts_api_read_session", "summary": "Read the current session", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SessionOut"}}}}}, "tags": ["session"]}}, "/api/session/login": {"post": {"operationId": "accounts_api_sign_in", "summary": "Sign in", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SessionOut"}}}}}, "tags": ["session"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginIn"}}}, "required": true}}}, "/api/session/logout": {"post": {"operationId": "accounts_api_sign_out", "summary": "Sign out", "parameters": [], "responses": {"204": {"description": "No Content"}}, "tags": ["session"], "security": [{"SessionAuth": []}]}}, "/api/session/signup": {"post": {"operationId": "accounts_api_sign_up", "summary": "Create a user and sign in", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SessionOut"}}}}}, "tags": ["session"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/SignupIn"}}}, "required": true}}}, "/api/session/preferences": {"patch": {"operationId": "accounts_api_change_preferences", "summary": "Change the preferences", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PreferencesOut"}}}}}, "tags": ["session"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/s