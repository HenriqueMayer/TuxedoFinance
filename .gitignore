# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Django
# `db.sqlite3` itself is tracked on purpose — see README, "Using this
# repository as a template". Its transient journal never is.
db.sqlite3-journal
db.sqlite3-shm
db.sqlite3-wal
staticfiles/
# Root-anchored so it matches Django's MEDIA_ROOT without also excluding
# `docs/media/`.
/media/
*.log
local_settings.py

# Raw screen recordings (~70 MB, above GitHub's push limit). The compressed
# re-encodes beside them are the ones committed.
docs/media/*.mp4

# Tailwind production build — generated by the standalone CLI at Docker
# build time (or locally, see README).
static/css/output.css
tailwindcss

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Environment variables
.env
