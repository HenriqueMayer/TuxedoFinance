# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Django
# Each installation owns its local database. Keep the root database and its
# transient journal/WAL files out of version control.
/db.sqlite3
db.sqlite3-journal
db.sqlite3-shm
db.sqlite3-wal
# Root-anchored so it matches Django's MEDIA_ROOT without also excluding
# `docs/media/`.
/media/
*.log
local_settings.py
.coverage
coverage.xml
htmlcov/

# Raw screen recordings (~70 MB, above GitHub's push limit). The compressed
# re-encodes beside them are the ones committed.
docs/media/*.mp4

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Environment variables
.env

# Other
.codex
.opencode
AGENTS.md
project_review.md
roadmap_brand.md
ROADMAP.md
