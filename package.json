{
  "name": "tuxedo-finance-frontend",
  "private": true,
  "scripts": {
    "build:css": "node scripts/build_css.mjs",
    "preview:capture": "bash scripts/preview/capture_preview.sh",
    "test:unit": "node --test tests/tooling/*.test.cjs",
    "test:e2e": "uv run python scripts/run_e2e.py",
    "test:preview": "playwright test --config=tests/preview/playwright.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.28"
  }
}
