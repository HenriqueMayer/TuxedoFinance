# Copy to backend/.env and set a private value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-generated-secret-key

# Optional settings and their defaults
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOW_SIGNUPS=True
LOG_LEVEL=INFO
TUXEDO_TIME_ZONE=America/Sao_Paulo
# TUXEDO_DATA_DIR=/absolute/path/to/tuxedo-finance-data
