#: planning/attention.py:140
#, python-format
msgid ""
"%(category)s: paid %(currency)s %(actual)s so far; %(forecast)s with the "
"amounts still due this month; limit %(limit)s. Card purchases count in the "
"month in which their invoice is due."
msgstr ""
"%(category)s: pago %(currency)s %(actual)s até agora; %(forecast)s com os "
"valores ainda devidos neste mês; limite %(limit)s. Compras no cartão contam "
"no mês de vencimento da fatura."

#: planning/attention.py:165
#, python-format
msgid ""
"%(account)s reaches %(currency)s %(balance)s on %(date)s. The projection "
"uses the current balance, recorded and recurring movements, unpaid invoices "
"and occurrences that wait for confirmation through %(end)s."
msgstr ""
"%(account)s chega a %(currency)s %(balance)s em %(date)s. A projeção usa o "
"saldo atual, os movimentos registrados e recorrentes, as faturas não pagas e "
"as ocorrências que aguardam confirmação até %(end)s."

#: planning/attention.py:173
msgid "Projected bank cash shortage"
msgstr "Falta prevista de caixa bancário"

#: planning/attention.py:187
#, python-format
msgid ""
"%(goal)s: with %(currency)s %(contribution)s per month, the goal is reached "
"in %(projected)s, %(months)s month after the target month. The target date "
"needs %(required)s per month."
msgid_plural ""
"%(goal)s: with %(currency)s %(contribution)s per month, the goal is reached "
"in %(projected)s, %(months)s months after the target month. The target date "
"needs %(required)s per month."
msgstr[0] ""
"%(goal)s: com %(currency)s %(contribution)s por mês, a meta é atingida em "
"%(projected)s, %(months)s mês depois do mês da meta. A data da meta precisa "
"de %(required)s por mês."
msgstr[1] ""
"%(goal)s: com %(currency)s %(contribution)s por mês, a meta é atingida em "
"%(projected)s, %(months)s meses depois do mês da meta. A data da meta "
"precisa de %(required)s por mês."

#: planning/attention.py:196
msgid "Goal behind plan"
msgstr "Meta atrasada em relação ao plano"

#: planning/attention.py:208
#, python-format
msgid ""
