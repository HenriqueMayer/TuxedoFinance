# Select an image from a release that includes Docker support.
# For a local build, use tuxedo-finance:local instead.
TUXEDO_IMAGE=ghcr.io/henriquemayer/tuxedofinance:REPLACE_WITH_RELEASE_TAG
# Generate this once; preserve the actual value across upgrades.
SECRET_KEY=replace-with-a-generated-secret-key
TUXEDO_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOW_SIGNUPS=True
HTTPS=False
LOG_LEVEL=INFO
# Keep disabled until an explicit real-account validation; no inference adapter is enabled.
ASSISTANT_OPENAI_AUTH_ENABLED=False
ASSISTANT_OPENAI_INFERENCE_ENABLED=False
