# Settings for compose.yaml. Copy to .env beside compose.yaml and set the values.

# A released image, or tuxedo-finance:local for an image that you built.
TUXEDO_IMAGE=ghcr.io/henriquemayer/tuxedofinance:REPLACE_WITH_RELEASE_TAG
# Generate this once and keep it across upgrades:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-generated-secret-key
TUXEDO_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOW_SIGNUPS=True
HTTPS=False
LOG_LEVEL=INFO
TUXEDO_TIME_ZONE=America/Sao_Paulo
